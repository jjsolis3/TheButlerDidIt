          { "id": "poster", "prop": "poster", "x": 440, "y": 60, "w": 160, "h": 220, "label": "poster", "look": "Glowing letters appear: THE PROFESSOR LOOKS TWICE.", "clue": "Glowing letters on the poster: THE PROFESSOR LOOKS TWICE.", "requires": "uv-lamp", "lockedText": "Just a faded poster. Maybe in a different light?" },
          { "id": "painting", "prop": "painting", "x": 660, "y": 60, "w": 180, "h": 200, "label": "portrait", "look": "The professor, holding a dial set to {key:formula}." },
