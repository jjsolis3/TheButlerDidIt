  "puzzles": [
    {
      "id": "gather",
      "title": "The Professor's Bench",
      "kind": "search",
      "prompt": "Search the crate, the drawer and the poster.",
      "finds": ["crate", "drawer", "poster"],
      "rewards": ["cabinet-key"],
      "hints": ["The bulb fits the lamp.", "Shine the lamp on the poster."],
      "solvedText": "A small key drops out of the poster frame."
    },
    {
      "id": "formula",
      "title": "The Blackboard",
      "kind": "text",
      "prompt": "Scrawled on the blackboard: {cipher}",
      "generator": { "type": "cipher", "cipher": "shift", "words": ["atom", "flask", "spark", "magnet", "crystal", "science"] },
      "hints": ["The portrait holds a number.", "Move every letter back along the alphabet by that number.", "It spells {answer}."],
      "solvedText": "The blackboard wipes itself clean."
    },
    {
      "id": "sequence",
      "title": "The Safe",
      "kind": "code",
      "prompt": "The safe's display flashes: {sequence}",
      "requires": ["cabinet-key"],
      "rewards": ["locket"],
      "generator": { "type": "sequence" },
      "hints": ["Look at how each number changes.", "The next number is {answer}."],
      "solvedText": "The safe clicks open. Inside: a locket."
    },
    {
      "id": "digits",
      "title": "The Counter",
      "kind": "code",
      "prompt": "A counter with three dials.",
      "minMinutes": 45,
      "generator": { "type": "digitFacts", "count": 3, "pieceTemplate": "The {ordinal} digit is {fact}." },
      "hints": ["Each of you knows one digit.", "Put them in order."],
      "solvedText": "The counter rolls over."
    },
    {
      "id": "jars",
      "title": "The Jars",
      "kind": "code",
      "prompt": "Line up {items}. The code is each jar's spot, 1 on the far left, in that order.",
      "generator": { "type": "deduction", "words": ["red jar", "blue jar", "green jar", "gold jar", "silver jar"], "pieceTemplate": "A note: {clue}" },
      "hints": ["Start with the jar you know most about.", "Write the spots down in a row."],
      "solvedText": "The jars glow in order."
    },
    {
      "id": "frame",
      "title": "The Empty Frame",
      "kind": "use",
      "prompt": "An empty picture frame on the wall.",
      "requires": ["photo"],
      "rewards": ["exit-key"],
      "hints": ["Look closely at the locket."],
      "solvedText": "The photo slides in and a key falls out."
    },
    {
      "id": "lights",
      "title": "The Light Panel",
      "kind": "switches",
      "prompt": "Press a light and it flips, with its neighbours. Turn them all on.",
      "generator": { "type": "switches" },
      "hints": ["Work from the top row down.", "Press {answer}."],
      "solvedText": "Every light glows."
    },
    {
      "id": "signal",
      "title": "The Telegraph",
      "kind": "text",
      "prompt": "The telegraph taps: {cipher}",
      "minDifficulty": "hard",
      "generator": { "type": "cipher", "cipher": "morse", "words": ["beaker", "quartz", "oxygen", "helium"] },
      "hints": ["The manual has a table in invisible ink.", "Read it letter by letter."],
      "solvedText": "The telegraph falls silent."
    },
    {
      "id": "door",
      "title": "The Lab Door",
      "kind": "use",
      "prompt": "The lab door is locked.",
      "requires": ["exit-key"],
      "hints": ["You need a key."],
      "solvedText": "The door swings open."
    }
  ],
  "items": [
    { "id": "bulb", "name": "a glass bulb" },
    { "id": "lamp-body", "name": "an empty lamp" },
    { "id": "uv-lamp", "name": "a UV lamp", "description": "It glows violet." },
    { "id": "cabinet-key", "name": "a small key" },
    { "id": "locket", "name": "a locket", "inspect": "Something is tucked behind the picture inside.", "inspectGives": "photo" },
    { "id": "photo", "name": "a photo of the professor" },
    { "id": "manual", "name": "a lab manual", "inspect": "Under the UV light, a table appears: {key:signal}", "inspectRequires": "uv-lamp" },
    { "id": "exit-key", "name": "a brass key" }
  ],
  "recipes": [
    { "items": ["bulb", "lamp-body"], "makes": "uv-lamp", "text": "The bulb screws in and the lamp glows violet." }
  ]
