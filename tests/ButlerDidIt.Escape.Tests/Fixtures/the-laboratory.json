          { "id": "shelf", "prop": "shelf", "x": 260, "y": 40, "w": 200, "h": 80, "label": "top shelf", "look": "Empty jars.", "hidesPieces": true },
          { "id": "barrel", "prop": "barrel", "x": 260, "y": 420, "w": 120, "h": 160, "label": "barrel", "look": "A barrel of sand.", "hidesPieces": true },
          { "id": "lamp", "prop": "lamp", "x": 420, "y": 300, "w": 80, "h": 160, "label": "lamp", "look": "A desk lamp.", "hidesPieces": true },
          { "id": "box", "prop": "box", "x": 540, "y": 460, "w": 120, "h": 100, "label": "box", "look": "Packing peanuts.", "hidesPieces": true },
          { "id": "chest", "prop": "chest", "x": 700, "y": 440, "w": 160, "h": 120, "label": "chest", "look": "Old lab coats.", "hidesPieces": true },
