# Copy to .env for local docker compose runs. In Coolify, set these in the
# resource's "Environment Variables" tab instead.
POSTGRES_PASSWORD=change-me-to-something-long
ALLOW_REGISTRATION=true

# Optional: email for "Forgot password?" and sign-up confirmation (any SMTP provider).
PUBLIC_URL=                # e.g. https://mystery.example.com (links in emails use this)
SMTP_HOST=                 # e.g. smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                 # e.g. The Butler Did It <butler@example.com>
REQUIRE_CONFIRMED_EMAIL=false  # true: hosts must confirm their email before creating parties
APP_PORT=8080

# ---- AI game master (optional). Or configure it on the Admin -> AI page.
# One provider for all three roles; add more providers on the admin page.
AI_MONTHLY_BUDGET_USD=25
AI_PROVIDER_NAME=
AI_PROVIDER_KIND=          # Anthropic | OpenAI | Gemini | Ollama
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=      # only for Ollama or OpenAI-compatible servers
AI_STORYTELLER_MODEL=      # e.g. claude-opus-5
AI_ACTOR_MODEL=            # e.g. claude-sonnet-5
AI_INSPECTOR_MODEL=        # e.g. claude-sonnet-5

# Optional: voices and pictures (even if the provider above is Claude).
AI_MEDIA_PROVIDER_NAME=      # e.g. OpenAI or Gemini (leave empty to skip)
AI_MEDIA_PROVIDER_KIND=      # OpenAI (the default) or Gemini; ElevenLabs or Piper for voices only; StableDiffusion for pictures only
AI_MEDIA_API_KEY=
AI_MEDIA_BASE_URL=           # only for a server of your own, e.g. http://piper:5000 or http://stable-diffusion:7860
AI_VOICE_MODEL=              # e.g. tts-1, gemini-2.5-flash-preview-tts, eleven_multilingual_v2, or a Piper voice
AI_IMAGE_MODEL=              # e.g. dall-e-3, gemini-2.5-flash-image (Nano Banana), or "default" for Stable Diffusion
AI_VIDEO_MODEL=              # optional, costs money: escape room reveal clips, e.g. sora-2 or veo-3.0-fast-generate-001

# ---- Payments (optional; see "Payments with Stripe" in docs/deploy-coolify.md).
# Off until STRIPE_SECRET_KEY is set: hosts then get their games from the free trial and from you, as before.
STRIPE_SECRET_KEY=           # sk_test_... to try it, sk_live_... to take real payments (mark it as a secret)
STRIPE_WEBHOOK_SECRET=       # whsec_..., the signing secret of the webhook endpoint https://<your domain>/api/billing/webhook
# The price id (price_...) of each plan you sell, from the Stripe dashboard. Leave a plan empty to not sell it.
STRIPE_PRICE_MYSTERIES_MONTHLY=
STRIPE_PRICE_MYSTERIES_YEARLY=
STRIPE_PRICE_ESCAPE_MONTHLY=
STRIPE_PRICE_ESCAPE_YEARLY=
STRIPE_PRICE_BOTH_MONTHLY=
STRIPE_PRICE_BOTH_YEARLY=
STRIPE_PRICE_MYSTERIES_PASS= # one-time prices: a party pass
STRIPE_PRICE_ESCAPE_PASS=
STRIPE_PRICE_BOTH_PASS=
PASS_HOURS=72                # how long a party pass lasts, from when it's paid for
PAYMENT_GRACE_DAYS=7         # how long a host keeps their games after a renewal payment fails
STRIPE_AUTOMATIC_TAX=false   # true once Stripe Tax is set up in the Stripe dashboard

# ---- More than one server (optional; see "Running more than one server" in docs/deploy-coolify.md).
# One server needs none of this.
SCALE_MULTI_INSTANCE=false   # true: servers coordinate through the database
REDIS_URL=                   # e.g. redis:6379, so every server hears every live update
DATA_PROTECTION_STORE=       # Database: every server shares the sign-in keys
MIGRATE_ON_STARTUP=true      # false if you run "--migrate" as a deploy step instead
MEDIA_STORAGE=Local          # S3: pictures, voices and selfies in a bucket every server can reach
S3_SERVICE_URL=              # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION=auto               # e.g. us-east-1 on AWS
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
