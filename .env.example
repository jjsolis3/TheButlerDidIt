# Copy to .env for local docker compose runs. In Coolify, set these in the
# resource's "Environment Variables" tab instead.
POSTGRES_PASSWORD=change-me-to-something-long
ALLOW_REGISTRATION=true

# Optional: email for "Forgot password?" and sign-up confirmation (any SMTP provider).
PUBLIC_URL=                # e.g. https://mystery.example.com (links in emails use this)
SMTP_HOST=                 # e.g. smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                 # e.g. The Butler Did It <butler@example.com>
REQUIRE_CONFIRMED_EMAIL=false  # true: hosts must confirm their email before creating parties
APP_PORT=8080

# ---- AI game master (optional). Or configure it on the Admin -> AI page.
# One provider for all three roles; add more providers on the admin page.
AI_MONTHLY_BUDGET_USD=25
AI_PROVIDER_NAME=
AI_PROVIDER_KIND=          # Anthropic | OpenAI | Gemini | Ollama
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=      # only for Ollama or OpenAI-compatible servers
AI_STORYTELLER_MODEL=      # e.g. claude-opus-5
AI_ACTOR_MODEL=            # e.g. claude-sonnet-5
AI_INSPECTOR_MODEL=        # e.g. claude-sonnet-5

# Optional: voices and pictures, from OpenAI or Gemini (even if the provider above is Claude).
AI_MEDIA_PROVIDER_NAME=      # e.g. OpenAI or Gemini (leave empty to skip)
AI_MEDIA_PROVIDER_KIND=      # OpenAI (the default) or Gemini
AI_MEDIA_API_KEY=
AI_VOICE_MODEL=              # e.g. tts-1, or gemini-2.5-flash-preview-tts
AI_IMAGE_MODEL=              # e.g. dall-e-3, or gemini-2.5-flash-image (Nano Banana)

# ---- More than one server (optional; see "Running more than one server" in docs/deploy-coolify.md).
# One server needs none of this.
SCALE_MULTI_INSTANCE=false   # true: servers coordinate through the database
REDIS_URL=                   # e.g. redis:6379, so every server hears every live update
DATA_PROTECTION_STORE=       # Database: every server shares the sign-in keys
MIGRATE_ON_STARTUP=true      # false if you run "--migrate" as a deploy step instead
MEDIA_STORAGE=Local          # S3: pictures, voices and selfies in a bucket every server can reach
S3_SERVICE_URL=              # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION=auto               # e.g. us-east-1 on AWS
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
